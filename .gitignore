__pycache__/
*.pyc

# run.py's private environment -- hundreds of MB, never committed
.venv/
venv/
*.bak
*.bak2
state.json
state.json.bak*
# never commit anyone's downloads or sessions
instagram/
session-*
latest-stamps.ini

# generated thumbnails (also lives in ~/.cache by default)
thumbs/

# runtime databases (rebuilt per install)
*.db
*.db-shm
*.db-wal
# corrupted state recovery artifacts
*.corrupt
*.tmp

# Built AppImage
/dist/

# Sidecar build (packaging/sidecar/build.sh): build-only venv and the frozen
# bundle. Both are regenerable and neither belongs in git.
.venv-build/
dist/sidecar/

# Tauri/Rust build output (never committed; ~GBs)
src-tauri/target/
# permission schemas are regenerated by tauri-build on every compile
src-tauri/gen/schemas/

# scripts/ci-local.sh's throwaway venv (regenerable, rebuilds per run)
.ci-venv/

# stdout of the container bundle builds (src-tauri/build-in-container.sh);
# kept locally so a bundle can be audited after the fact, never committed
.build-logs/

# the onefile comparison build (HWA_ONEFILE=1, see docs/desktop-shell.md)
/dist-onefile/
