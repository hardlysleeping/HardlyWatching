__pycache__/
*.pyc

# run.py's private environment -- hundreds of MB, never committed
.venv/
venv/
*.bak
*.bak2
state.json
state.json.bak*
# never commit anyone's downloads or sessions
instagram/
session-*
latest-stamps.ini

# generated thumbnails (also lives in ~/.cache by default)
thumbs/

# runtime databases (rebuilt per install)
*.db
*.db-shm
*.db-wal
# corrupted state recovery artifacts
*.corrupt
*.tmp

# Built AppImage
/dist/

# Tauri/Rust build output (never committed; ~GBs)
src-tauri/target/
# permission schemas are regenerated by tauri-build on every compile
src-tauri/gen/schemas/
